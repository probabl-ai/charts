{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/charts/.+/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*appVersion:\\s*\"?(?<currentValue>[\\d.]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "rg.fr-par.scw.cloud/probabl-skh/skh",
        "rg.fr-par.scw.cloud/probabl-skh/skh-ui"
      ],
      "groupName": "skore-hub release",
      "automerge": false,
      "pinDigests": false
    }
  ],
  "bumpVersions": [
    {
      "description": "Bump both skore-hub chart versions (patch) when their appVersion is updated. Explicit paths (not {{packageFileDir}}) so grouped updates bump every chart, not only the first.",
      "filePatterns": [
        "charts/skore-hub-backend/Chart.yaml",
        "charts/skore-hub-frontend/Chart.yaml"
      ],
      "matchStrings": [
        "version:\\s(?<version>[^\\s]+)"
      ],
      "bumpType": "patch"
    }
  ]
}
